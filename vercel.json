{
  "headers": [
    {
      "source": "/sitemap-main.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/barberia-en-zapopan-que-buscar",
      "destination": "/blog/barberia-en-los-tulipanes-que-buscar",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap-main\\.xml|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}